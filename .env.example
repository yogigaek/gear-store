# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# PostgreSQL from `docker compose up -d` (production: the Neon connection string)
DATABASE_URL=postgresql://gear:gear@localhost:5436/gear

# API
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Auth: generate with `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-to-at-least-32-random-characters
# Email: Mailpit from docker compose (inbox at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
# Payments: Midtrans sandbox server key (Dashboard → Settings → Access Keys, sandbox environment)
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME
