{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://yogi-store.vercel.app/api"
      }
    },
    "production": {
      "extends": "preview",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
