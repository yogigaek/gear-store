generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Accounts ────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// stored lower-cased; uniqueness is case-insensitive in practice
  email           String    @unique
  name            String
  passwordHash    String
  role            Role      @default(CUSTOMER)
  emailVerifiedAt DateTime?
  /// one-click demo accounts: no usable password, reset on a schedule
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    Session[]
  emailTokens EmailToken[]
  wishlist    WishlistItem[]
  cartItems   CartItem[]
  cartBuilds  CartBuild[]
  cartMerges  CartMerge[]
  addresses   Address[]
  orders      Order[]
  reviews     Review[]
}

/// One signed-in device. Its refresh tokens rotate; presenting a used one after a short grace window revokes the whole session.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque token; the token itself is never stored
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@index([sessionId])
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model EmailToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, purpose])
}

// ── Catalogue ───────────────────────────────────────────────────────────────

/// A part type. Those with a `slot` are the E-1's build slots, in that order; the rest are accessories.
model Category {
  id          String    @id @default(uuid(7)) @db.Uuid
  slug        String    @unique
  name        String
  description String
  sortOrder   Int       @default(0)
  /// its place in the build, 0 first; null for accessories
  slot        Int?      @unique
  products    Product[]
}

/// The 3D module that draws a part on the E-1.
enum PartModule {
  FRAME
  BATTERY
  SHOCK
  FORK
  WHEELSET
  DRIVETRAIN
  COCKPIT
  SEAT
  ACCESSORY
}

/// A part. A part in a slot category is an option for that slot of the build.
model Product {
  id          String     @id @default(uuid(7)) @db.Uuid
  slug        String     @unique
  name        String
  /// part code printed on the spec plate, e.g. E1-FR-M
  model       String
  description String
  module      PartModule
  /// whole Rupiah; CHECK (price >= 0) in the migration
  price       Int
  /// CHECK (stock >= 0) in the migration, so no order can oversell
  stock       Int
  isActive    Boolean    @default(true)
  categoryId  String     @db.Uuid
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  specs        ProductSpec[]
  colors       ProductColor[]
  wishlistBy   WishlistItem[]
  inCarts      CartItem[]
  inBuilds     CartBuildPart[]
  orderItems   OrderItem[]
  reviews      Review[]
  conflictsAsA PartConflict[]  @relation("conflictA")
  conflictsAsB PartConflict[]  @relation("conflictB")

  @@index([categoryId, isActive])
}

/// Two parts that cannot go on the same bike. Stored once per pair: CHECK ("aId" < "bId") in the migration.
model PartConflict {
  aId    String  @db.Uuid
  a      Product @relation("conflictA", fields: [aId], references: [id], onDelete: Cascade)
  bId    String  @db.Uuid
  b      Product @relation("conflictB", fields: [bId], references: [id], onDelete: Cascade)
  /// shown to the buyer, e.g. "The 750 Wh battery does not fit the small frame's down tube."
  reason String

  @@id([aId, bId])
  @@index([bId])
}

model ProductSpec {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  position  Int
  /// one of the three printed on the card's spec plate
  onPlate   Boolean @default(false)

  @@unique([productId, position])
}

model ProductColor {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  label     String
  hex       String
  position  Int

  @@unique([productId, key])
}

model WishlistItem {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// '' for products without finishes (an empty string, not NULL, so the unique key below holds)
  colorKey  String   @default("")
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, colorKey])
}

/// A guest cart already added to this account, by the key its browser sent: a retried merge (the page
/// reloaded while the first was in flight, or its reply was lost) is recognised and adds nothing twice.
model CartMerge {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   @db.Uuid
  createdAt DateTime @default(now())

  @@id([userId, key])
}

/// A bike in a cart: one part per slot and the frame's colour. Checked and priced again at every read.
model CartBuild {
  id        String          @id @default(uuid(7)) @db.Uuid
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  colorKey  String
  /// CHECK (quantity BETWEEN 1 AND 10) in the migration
  quantity  Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  parts     CartBuildPart[]

  @@index([userId])
}

model CartBuildPart {
  cartBuildId String    @db.Uuid
  cartBuild   CartBuild @relation(fields: [cartBuildId], references: [id], onDelete: Cascade)
  productId   String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([cartBuildId, productId])
  @@index([productId])
}

// ── Checkout ────────────────────────────────────────────────────────────────

model Address {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   @default("")
  recipient  String
  /// +62… normalised
  phone      String
  line1      String
  line2      String   @default("")
  city       String
  province   String
  postalCode String
  /// at most one per user: partial unique index in the migration
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

enum RefundStatus {
  NONE
  /// money arrived after the order closed and must go back
  NEEDED
  DONE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

/// Prices, names and the address are copied in at checkout, so an invoice never changes afterwards.
model Order {
  id               String       @id @default(uuid(7)) @db.Uuid
  /// shown to people and sent to Midtrans as order_id: RKT-YYMMDD-XXXXXX
  number           String       @unique
  /// orders outlive accounts: an account with orders cannot be deleted by accident
  userId           String       @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  status           OrderStatus  @default(PENDING_PAYMENT)
  subtotal         Int
  shippingFee      Int
  /// CHECK (total = subtotal + shippingFee) in the migration
  total            Int
  shippingZone     String
  shipRecipient    String
  shipPhone        String
  shipLine1        String
  shipLine2        String
  shipCity         String
  shipProvince     String
  shipPostalCode   String
  /// the client's key for this checkout attempt: a retried request returns the same order
  idempotencyKey   String
  paymentExpiresAt DateTime
  paidAt           DateTime?
  closedAt         DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  courier          String?
  trackingNumber   String?
  /// NEEDED rows have a partial index in the migration (the admin's refund queue)
  refundStatus     RefundStatus @default(NONE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  items   OrderItem[]
  builds  OrderBuild[]
  events  OrderEvent[]
  payment Payment?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, paymentExpiresAt])
  @@index([createdAt])
  @@index([status, paidAt])
}

model OrderItem {
  id         String      @id @default(uuid(7)) @db.Uuid
  orderId    String      @db.Uuid
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String?     @db.Uuid
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  slug       String
  name       String
  model      String
  colorKey   String
  colorLabel String?
  unitPrice  Int
  quantity   Int
  /// CHECK (lineTotal = unitPrice * quantity) in the migration
  lineTotal  Int
  /// the bike this part went into; null for a part bought on its own
  buildId    String?     @db.Uuid
  build      OrderBuild? @relation(fields: [buildId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([buildId])
}

/// A bike as bought: its parts are the order items pointing at it, each at quantity × this build's quantity.
model OrderBuild {
  id         String      @id @default(uuid(7)) @db.Uuid
  orderId    String      @db.Uuid
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label      String
  colorKey   String
  colorLabel String?
  quantity   Int
  /// one bike: the sum of its parts' prices at checkout
  unitPrice  Int
  /// CHECK (lineTotal = unitPrice * quantity) in the migration
  lineTotal  Int
  items      OrderItem[]

  @@index([orderId])
}

/// The order's timeline, oldest first.
model OrderEvent {
  id        String      @id @default(uuid(7)) @db.Uuid
  orderId   String      @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id                String   @id @default(uuid(7)) @db.Uuid
  orderId           String   @unique @db.Uuid
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String   @default("midtrans")
  redirectUrl       String?
  transactionId     String?  @unique
  transactionStatus String?
  paymentType       String?
  grossAmount       Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Every correctly signed payment notification as received: the audit trail for payment disputes. Forged and
/// malformed calls are only logged (rows with `signatureValid` false date from before that).
model PaymentNotification {
  id                String   @id @default(uuid(7)) @db.Uuid
  orderNumber       String
  transactionId     String?
  transactionStatus String?
  signatureValid    Boolean
  outcome           String
  payload           Json
  receivedAt        DateTime @default(now())

  @@index([orderNumber])
}

// ── Reviews ─────────────────────────────────────────────────────────────────

/// One per buyer and product, editable. Only accounts with a paid order for the product can write one.
model Review {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// CHECK (rating BETWEEN 1 AND 5) in the migration
  rating    Int
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, createdAt])
}
